# ===== इस फ़ाइल को कॉपी करके ".env" नाम दें (सिर्फ़ लोकल टेस्ट के लिए) =====
# Render पर यही सारे नाम "Environment" सेक्शन में डालने हैं। .env को GitHub पर कभी अपलोड न करें।

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...   # "service_role" key (secret!) — anon key नहीं

# कोई भी लंबा रैंडम टेक्स्ट (32+ अक्षर)। लॉगिन टोकन इसी से बनते हैं।
JWT_SECRET=badalo-isko-koi-lamba-random-text-12345678

# आपका ईमेल — इसे पहली बार लॉगिन करते ही Admin बन जाएगा (कई हों तो कॉमा से अलग करें)
ADMIN_EMAIL=aap@example.com

# Brevo → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@yourdomain.com     # Brevo में verified sender होना चाहिए
BREVO_SENDER_NAME=आज की धार

# रात के ऑटो-चेकआउट को बाहर से ट्रिगर करने के लिए गुप्त कोड (cron-job.org के लिए)
CRON_SECRET=koi-gupt-code-yahan-likho

# production रखें Render पर
NODE_ENV=development
PORT=3000
